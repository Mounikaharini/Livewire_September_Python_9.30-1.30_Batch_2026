#If a user buy 50-74 chocolates at same time -> 9% discount is applied
#If a user buy 75-100 chocolates at same time -> 13% discount is applied
#If all chocolates are sold out means print ("Bye Bye")
#Enter the count : n
#Total Amount To Pay :
#Actual Amount :
#Discount Amount :
#Remaining Avaliable Chocolates :

chocolate = 100
while chocolate>0 and True:
    n = int(input("Enter the count : "))
    chocolate = chocolate - n
    if chocolate<0:
        print("Bye Bye")
    else:
        discount = 0
        total_price = 0
        total_amount = 0
        if n>=1 and n<10:
            total_price = n * 2
            total_amount = total_price
        elif n>=10 and n<20:
            total_price = n * 2
            discount = (total_price/100)*5
            total_amount = total_price - discount
        elif n>=20 and n<50:
            total_price = n * 2
            discount = (total_price/100)*7
            total_amount = total_price - discount
        elif n>=50 and n<75:
            total_price = n * 2
            discount = (total_price/100)*9
            total_amount = total_price - discount
        elif n>=75 and n<=100:
            total_price = n * 2
            discount = (total_price/100)*13
            total_amount = total_price - discount
        print("Total Amount To Pay : ",total_amount)
        print("Actual Amount : ",total_price)
